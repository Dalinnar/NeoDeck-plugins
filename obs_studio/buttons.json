{
  "obs_studio": {
    "change_screne": {
      "command": "/obs_change_scene {obs_scene}",
      "inputs": [
        {
          "TYPE": "select",
          "name": "obs_scene",
          "options_url": "/obs/get_scenes"
        }
      ]
    },
    "open scenes": {
      "command": "$open_scenes()",
      "inputs": []
    },
    "open sources": {
      "command": "$open_sources()",
      "inputs": []
    },
    "trigger_hotkey": {
      "command": "/obs_trigger_hotkey {obs_hotkey}",
      "inputs": [
        {
          "TYPE": "input text",
          "name": "obs_hotkey"
        }
      ]
    },
    "toggle_recording": {
      "command": "/obs_toggle_recording",
      "inputs": [],
      "toggleable": true
    },
    "start_recording": {
      "command": "/obs_start_recording",
      "inputs": []
    },
    "stop_recording": {
      "command": "/obs_stop_recording",
      "inputs": []
    },
    "toggle_streaming": {
      "command": "/obs_toggle_streaming",
      "toggleable": true,
      "inputs": []
    },
    "start_streaming": {
      "command": "/obs_start_streaming",
      "inputs": []
    },
    "stop_streaming": {
      "command": "/obs_stop_streaming",
      "inputs": []
    },
    "toggle_source": {
      "command": "/obs_toggle_source {obs_source}",
      "toggleable": true,
      "inputs": [
        {
          "TYPE": "select",
          "name": "obs_source",
          "options_url": "/obs/get_sources"
        }
      ]
    },
    "set_volume": {
      "command": "!obs_set_volume {obs_source}",
      "min": "0",
      "max": "100",
      "inputs": [
        {
          "TYPE": "select",
          "name": "obs_source",
          "options_url": "/obs/get_audio_sources"
        }
      ]
    },
    "toggle_virual_camera": {
      "toggleable": true,
      "command": "/obs_toggle_virtual_camera",
      "inputs": []
    },
    "raw_ws_request": {
      "command": "/obs_raw_request |{requestType}| |{requestData}|",
      "inputs": [
        {
          "TYPE": "input text",
          "name": "requestType"
        },
        {
          "TYPE": "textarea",
          "name": "requestData"
        }
      ]
    }
  }
}